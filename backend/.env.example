DATABASE_URL=postgresql+psycopg://nestaprime:nestaprime_dev_password@localhost:5432/nestaprime_estimator
SECRET_KEY=change-this-to-a-random-secret-before-any-real-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=development
# Comma-separated. Defaults to the Vite dev server if unset -- production
# sets its own (e.g. http://65.1.234.78) via this env var, not a code change.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Amendment 8: the company's self-hosted WhatsApp backend (wa-gateway).
# Leave all three blank to disable real WhatsApp sending (Messages fall
# back to a fast, clear FAILED instead of hanging on a network call).
WA_GATEWAY_BASE_URL=
WA_GATEWAY_API_KEY=
WA_GATEWAY_WEBHOOK_SECRET=

# Amendment 8: Telegram Bot API token (from @BotFather). Leave blank to
# disable real Telegram sending.
TELEGRAM_BOT_TOKEN=

# Amendment 13: AI-assisted drafting (quotation cover notes, message
# drafts, report summaries) -- always a human-reviewed draft, never
# auto-sent. Leave blank to disable; the "Draft with AI" buttons then
# report "not configured" instead of hanging.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Amendment 8 continuation (Section 17): real email sending via SMTP --
# any real mailbox works (Google Workspace, Microsoft 365, a
# transactional relay account). Leave SMTP_HOST/USERNAME/PASSWORD blank
# to disable real email sending (Messages fall back to a fast, clear
# FAILED instead of hanging on a network call).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
